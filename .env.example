NODE_ENV=development
HOST=127.0.0.1
PUBLIC_BASE_URL=http://127.0.0.1:8010
DATABASE_PATH=./data/commerce.sqlite
ADMIN_PASSWORD_HASH=
ORDER_ACCESS_SECRET=
# For sandbox, use your test SELLER access token and a public HTTPS tunnel URL above.
MP_MODE=sandbox
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Additional official carrier domains, comma-separated. Correios is already allowed.
TRACKING_HOSTS=
# Optional automatic shipping: authorized Melhor Envio account/app and services.
ME_MODE=sandbox
ME_TOKEN=
ME_USER_AGENT=
ME_SERVICES=
# Exact physically approved packaging recipes; see docs/checkout.md.
SHIPPING_PACKAGING_JSON=
